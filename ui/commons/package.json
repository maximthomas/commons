{
  "name": "forgerock-ui-commons",
  "description": "ForgeRock UI Commons",
  "private": true,
  "scripts": {
    "clean:jsdoc": "rimraf jsdoc",
    "prejsdoc": "npm run clean:jsdoc -s",
    "jsdoc": "jsdoc --configure jsdoc.json",
    "lint": "eslint \"src/main/js/**/*.js\" --format eslint-formatter-warning-summary",
    "build": "npm run lint",
    "default": "build"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-formatter-warning-summary": "^1.0.1",
    "jsdoc": "3.5.5",
    "rimraf": "2.5.3",
    "es5-ext": "0.10.53"
  }
}
