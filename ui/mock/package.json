{
  "name": "ui-mock",
  "description": "UI Demonstration",
  "private": true,
  "scripts": {
    "build": "npm run sync && webpack --mode production",
    "build_old": "npm run sync && webpack --mode production && npm run test",
    "build:dev": "npm run sync && webpack --mode development && npm run test",
    "dev": "npm run build:dev && webpack --watch --mode development",
    "sync": "webpack --config webpack.sync.js",
    "pretest": "npm run sync",
    "test": "node run-qunit.js",
    "lint": "eslint \"src/main/js/**/*.js\" --format eslint-formatter-warning-summary",
    "default": "npm run dev"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "es5-ext": "0.10.53",
    "eslint": "^9.0.0",
    "eslint-formatter-warning-summary": "^1.0.1",
    "eslint-webpack-plugin": "^4.2.0",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "mini-css-extract-plugin": "^2.9.1",
    "puppeteer": "^22.0.0",
    "qunit": "^2.21.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-remove-empty-scripts": "^1.1.1"
  }
}
